# Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV=development

# MongoDB Atlas Connection URI (Private - DO NOT COMMIT)
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details:
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/personal_finance_tracker?retryWrites=true&w=majority

# JSON Web Token Secret
JWT_SECRET=personal_finance_tracker_secret_jwt_key_2026_academic_demo

# Allowed CORS Origins (comma separated)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
