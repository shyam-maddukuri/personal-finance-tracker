# Server Port
PORT=5000

# MongoDB Connection URI
# Examples:
# 1. Local MongoDB: mongodb://localhost:27017/finance_tracker
# 2. MongoDB Atlas (Cloud): mongodb+srv://<username>:<password>@cluster0.mongodb.net/finance_tracker?retryWrites=true&w=majority
# Note: If no MongoDB instance is running locally, the application automatically launches
# an in-memory MongoDB database so that the project works immediately for academic demo.
MONGODB_URI=mongodb://localhost:27017/finance_tracker
